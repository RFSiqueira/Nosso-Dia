<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Planejamento do Casamento | M❤️R</title>
  <style>
    :root {
      --sage: #8f9f88;
      --sage-dark: #5f715b;
      --cream: #fffaf0;
      --paper: rgba(255, 252, 245, 0.92);
      --gold: #b9904d;
      --gold-soft: #e6c98d;
      --ink: #2f2a24;
      --muted: #756b61;
      --line: rgba(185,144,77,.38);
      --shadow: 0 18px 50px rgba(65, 52, 36, .20);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Georgia, 'Times New Roman', serif;
      color: var(--ink);
      background: #efe7d5;
      min-height: 100vh;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: linear-gradient(rgba(255,250,240,.35), rgba(255,250,240,.35)), url('data:image/png;base64,');
      background-size: cover;
      background-position: center;
      opacity: .38; /* fundo com cerca de 62% de transparência */
      z-index: -2;
    }
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, rgba(255,255,255,.45), rgba(255,250,240,.72));
      z-index: -1;
    }
    .wrap { width: min(1100px, 94%); margin: 0 auto; padding: 34px 0 60px; }
    header {
      text-align: center;
      padding: 34px 24px 28px;
      margin-bottom: 24px;
      background: rgba(255,250,240,.88);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(7px);
      position: relative;
      overflow: hidden;
    }
    header::before, header::after {
      content:"✿";
      position:absolute;
      color: rgba(185,144,77,.32);
      font-size: 68px;
      top: 18px;
    }
    header::before { left: 28px; transform: rotate(-18deg); }
    header::after { right: 28px; transform: rotate(18deg); }
    .logo {
      font-family: 'Brush Script MT', 'Segoe Script', cursive;
      font-size: clamp(48px, 8vw, 88px);
      line-height: 1;
      color: var(--gold);
      letter-spacing: 2px;
      text-shadow: 0 2px 0 rgba(255,255,255,.75);
    }
    .subtitle { margin: 8px 0 0; color: var(--sage-dark); letter-spacing: 3px; text-transform: uppercase; font-size: 13px; }
    .intro { margin: 18px auto 0; max-width: 720px; font-size: 18px; color: var(--muted); line-height: 1.5; }
    .grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    fieldset {
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--paper);
      padding: 24px;
      box-shadow: 0 12px 35px rgba(65,52,36,.13);
      backdrop-filter: blur(7px);
    }
    legend {
      padding: 0 12px;
      font-size: 24px;
      color: var(--sage-dark);
      font-weight: bold;
    }
    .hint { margin: 0 0 14px; color: var(--muted); font-style: italic; }
    .options { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px 14px; }
    label.choice {
      display: flex; gap: 10px; align-items: center;
      padding: 11px 12px;
      border: 1px solid rgba(143,159,136,.35);
      border-radius: 16px;
      background: rgba(255,255,255,.62);
      cursor: pointer;
      min-height: 46px;
    }
    label.choice:hover { border-color: var(--gold); background: rgba(255,248,232,.85); }
    input[type="radio"], input[type="checkbox"] { accent-color: var(--gold); transform: scale(1.1); }
    .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 12px; }
    .field { display: flex; flex-direction: column; gap: 6px; color: var(--sage-dark); font-weight: bold; }
    input[type="text"], input[type="number"], input[type="date"], input[type="time"], textarea {
      width: 100%;
      border: 1px solid rgba(143,159,136,.45);
      border-radius: 14px;
      padding: 12px 13px;
      font: 16px Arial, sans-serif;
      color: var(--ink);
      background: rgba(255,255,255,.82);
      outline: none;
    }
    textarea { min-height: 86px; resize: vertical; }
    input:focus, textarea:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(185,144,77,.15); }
    .actions {
      position: sticky;
      bottom: 16px;
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      padding: 18px;
      margin-top: 24px;
      background: rgba(255,250,240,.88);
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(8px);
    }
    button {
      border: none;
      border-radius: 999px;
      padding: 14px 24px;
      font: bold 15px Arial, sans-serif;
      cursor: pointer;
      letter-spacing: .3px;
    }
    .primary { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: white; }
    .secondary { background: var(--sage); color: white; }
    .ghost { background: transparent; color: var(--sage-dark); border: 1px solid rgba(95,113,91,.35); }
    #report { display:none; }
    .report-page {
      background: #fffaf0;
      padding: 35px;
      border: 1px solid var(--line);
      color: var(--ink);
      font-family: Georgia, 'Times New Roman', serif;
    }
    .report-logo { text-align:center; font-family:'Brush Script MT','Segoe Script',cursive; font-size:54px; color:var(--gold); }
    .report-title { text-align:center; margin:8px 0 28px; color:var(--sage-dark); letter-spacing:2px; text-transform:uppercase; }
    .report-section { border-top:1px solid var(--line); padding:14px 0; break-inside: avoid; }
    .report-section h3 { margin:0 0 8px; color:var(--sage-dark); }
    .report-section p { margin:5px 0; line-height:1.45; }
    .empty { color:#9b8f80; font-style:italic; }
    @media print {
      body::before, body::after, header, form, .actions { display:none !important; }
      body { background:white; }
      .wrap { width:100%; padding:0; }
      #report { display:block !important; }
      .report-page { border:0; padding:0; }
      @page { size: A4; margin: 16mm; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="logo">M❤️R</div>
      <p class="subtitle">Save the date • Planejamento do nosso casamento</p>
      <p class="intro">Vamos escolher juntos cada detalhe do nosso casamento e que cada escolha nos faça lembrar do quão grande e especial é o nosso amor!.</p>
    </header>

    <form id="weddingForm" class="grid">
      <fieldset>
        <legend>1. Formato</legend>
        <p class="hint">Como será a nossa celebração?</p>
        <div class="options" data-group="Formato">
          <label class="choice"><input type="radio" name="formato" value="Só cartório"> Só cartório</label>
          <label class="choice"><input type="radio" name="formato" value="Cartório + almoço"> Cartório + almoço</label>
          <label class="choice"><input type="radio" name="formato" value="Cartório + jantar"> Cartório + jantar</label>
          <label class="choice"><input type="radio" name="formato" value="Mini wedding"> Mini wedding</label>
          <label class="choice"><input type="radio" name="formato" value="Comemoração em casa"> Comemoração em casa</label>
          <label class="choice"><input type="radio" name="formato" value="Algo íntimo"> Algo íntimo</label>
          <label class="choice"><input type="radio" name="formato" value="Algo mais social"> Algo mais social</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>2. Quantidade</legend>
        <p class="hint">Quantos convidados teremos?.</p>
        <div class="options">
          <label class="choice"><input type="checkbox" name="quantidade" value="Só testemunhas"> Só testemunhas</label>
          <label class="choice"><input type="checkbox" name="quantidade" value="Família próxima"> Família próxima</label>
          <label class="choice"><input type="checkbox" name="quantidade" value="Amigos próximos"> Amigos próximos</label>
        </div>
        <div class="fields"><label class="field">Média estimada<input type="number" name="media_convidados" placeholder="Ex.: 20"></label></div>
      </fieldset>

      <fieldset>
        <legend>3. Nosso Orçamento</legend>
        <div class="fields">
          <label class="field">Orçamento Total<input type="text" name="orcamento_total" placeholder="Ex.: R$ 5.000,00"></label>
          <label class="field">Contribuição de Mai<input type="text" name="contribuicao_m" placeholder="Ex.: R$ 2.500,00"></label>
          <label class="field">Contribuição de Rafinha<input type="text" name="contribuicao_r" placeholder="Ex.: R$ 2.500,00"></label>
          <label class="field">O que podemos parcelar<textarea name="parcelar"></textarea></label>
          <label class="field">O que precisará ser à vista<textarea name="a_vista"></textarea></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>4. Data e horários</legend>
        <div class="fields">
          <label class="field">Nosso Casamento<input type="date" name="data_principal"></label>
          <label class="field">Horário do Cartório<input type="time" name="horario_cartorio"></label>
          <label class="field">Horário do Comes&Bebes<input type="time" name="horario_comemoracao"></label>
        </div>
        <div class="options" style="margin-top:14px">
          <label class="choice"><input type="radio" name="periodo" value="Manhã"> Manhã</label>
          <label class="choice"><input type="radio" name="periodo" value="Tarde"> Tarde</label>
          <label class="choice"><input type="radio" name="periodo" value="Noite"> Noite</label>
        </div>
        <div class="fields"><label class="field">Outras datas possíveis<textarea name="outras_datas"></textarea></label></div>
      </fieldset>

      <fieldset>
        <legend>5. Local da comemoração</legend>
        <div class="options">
          <label class="choice"><input type="radio" name="local" value="Restaurante"> Restaurante</label>
          <label class="choice"><input type="radio" name="local" value="Salão"> Salão</label>
          <label class="choice"><input type="radio" name="local" value="Casa"> Nossa Casa</label>
          <label class="choice"><input type="radio" name="local" value="Sítio"> Sítio</label>
          <label class="choice"><input type="radio" name="local" value="Cafeteria"> Cafeteria</label>
          <label class="choice"><input type="radio" name="local" value="Rooftop"> Rooftop</label>
          <label class="choice"><input type="radio" name="local" value="Sem comemoração"> Sem comemoração</label>
        </div>
        <div class="fields"><label class="field">Endereço do local<textarea name="local_detalhes"></textarea></label></div>
      </fieldset>

      <fieldset>
        <legend>6. Nossas Alianças</legend>
        <div class="options">
          <label class="choice"><input type="radio" name="aliancas" value="Vamos trocar alianças"> Vamos trocar nossas alianças</label>
          <label class="choice"><input type="radio" name="aliancas" value="Não vamos trocar agora"> Não vamos trocar por agora</label>
          <label class="choice"><input type="radio" name="aliancas" value="Ainda vamos decidir"> Vamos decidir com calma</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>7. Nossos Fotinhos</legend>
        <div class="options">
          <label class="choice"><input type="checkbox" name="fotografia" value="Fotógrafo profissional"> Fotógrafo profissional</label>
          <label class="choice"><input type="checkbox" name="fotografia" value="Ensaio"> Ensaio</label>
          <label class="choice"><input type="checkbox" name="fotografia" value="Só fotos do civil"> Só fotos do civil</label>
          <label class="choice"><input type="checkbox" name="fotografia" value="Celular mesmo"> Celular mesmo</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>8. Convites</legend>
        <div class="options">
          <label class="choice"><input type="radio" name="convite_tipo" value="Digital"> Digital</label>
          <label class="choice"><input type="radio" name="convite_tipo" value="Físico"> Físico</label>
          <label class="choice"><input type="radio" name="convite_estilo" value="Mais formal"> Mais formal</label>
          <label class="choice"><input type="radio" name="convite_estilo" value="Mais casual"> Mais casual</label>
        </div>
        <div class="fields"><label class="field">Lista final de convidados<textarea name="lista_convidados" placeholder="Digite os nomes ou cole a lista..."></textarea></label></div>
      </fieldset>

      <fieldset>
        <legend>9. Comidas e bebidas</legend>
        <div class="options">
          <label class="choice"><input type="checkbox" name="comida" value="Almoço"> Almoço</label>
          <label class="choice"><input type="checkbox" name="comida" value="Jantar"> Jantar</label>
          <label class="choice"><input type="checkbox" name="comida" value="Coquetel"> Coquetel</label>
          <label class="choice"><input type="checkbox" name="comida" value="Café"> Café</label>
          <label class="choice"><input type="checkbox" name="comida" value="Bolo"> Bolos</label>
          <label class="choice"><input type="checkbox" name="comida" value="Doces"> Doces</label>
          <label class="choice"><input type="checkbox" name="comida" value="Doces"> Brunch</label>
          <label class="choice"><input type="checkbox" name="bebida" value="Com bebida alcoólica"> Com bebida alcoólica</label>
          <label class="choice"><input type="checkbox" name="bebida" value="Sem bebida alcoólica"> Sem bebida alcoólica</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>10. Lua de mel ou Descanso</legend>
        <div class="options">
          <label class="choice"><input type="radio" name="lua_de_mel" value="Viagem"> Viagem</label>
          <label class="choice"><input type="radio" name="lua_de_mel" value="Hotel"> Hotel</label>
          <label class="choice"><input type="radio" name="lua_de_mel" value="Fim de semana juntos"> Fim de semana juntos</label>
          <label class="choice"><input type="radio" name="lua_de_mel" value="Nada por enquanto"> Nada por enquanto</label>
        </div>
        <div class="fields"><label class="field">Observações<textarea name="lua_obs"></textarea></label></div>
      </fieldset>

      <fieldset>
        <legend>11. Cartório</legend>
        <div class="fields">
          <label class="field">Qual cartório?<input type="text" name="cartorio" placeholder="Nome do cartório"></label>
          <label class="field">Observações/documentos<textarea name="cartorio_obs"></textarea></label>
        </div>
      </fieldset>
    </form>

    <div class="actions">
      <button class="primary" type="button" onclick="gerarPDF()">Gerar relatório em PDF</button>
      <button class="secondary" type="button" onclick="gerarRelatorio(); document.getElementById('report').scrollIntoView({behavior:'smooth'})">Visualizar relatório</button>
      <button class="ghost" type="button" onclick="document.getElementById('weddingForm').reset(); document.getElementById('report').innerHTML=''">Limpar escolhas</button>
    </div>

    <section id="report"></section>
  </div>

  <script>
    const sections = [
      ['Formato', ['formato']],
      ['Quantidade', ['quantidade', 'media_convidados']],
      ['Orçamento máximo', ['orcamento_total', 'contribuicao_m', 'contribuicao_r', 'parcelar', 'a_vista']],
      ['Data e horários', ['data_principal', 'horario_cartorio', 'horario_comemoracao', 'periodo', 'outras_datas']],
      ['Local da comemoração', ['local', 'local_detalhes']],
      ['Alianças', ['aliancas']],
      ['Fotografia', ['fotografia']],
      ['Convites', ['convite_tipo', 'convite_estilo', 'lista_convidados']],
      ['Comida e bebida', ['comida', 'bebida']],
      ['Lua de mel ou descanso', ['lua_de_mel', 'lua_obs']],
      ['Cartório', ['cartorio', 'cartorio_obs']]
    ];

    const labels = {
      formato:'Formato escolhido', quantidade:'Quantidade/Grupo', media_convidados:'Média estimada',
      orcamento_total:'Orçamento máximo total', contribuicao_m:'Contribuição de M', contribuicao_r:'Contribuição de R', parcelar:'Pode parcelar', a_vista:'Precisa ser à vista',
      data_principal:'Data principal', horario_cartorio:'Horário do cartório', horario_comemoracao:'Horário da comemoração', periodo:'Período', outras_datas:'Outras datas',
      local:'Local escolhido', local_detalhes:'Detalhes do local', aliancas:'Decisão', fotografia:'Fotografia', convite_tipo:'Tipo de convite', convite_estilo:'Estilo do convite', lista_convidados:'Lista final de convidados',
      comida:'Comida', bebida:'Bebida', lua_de_mel:'Plano', lua_obs:'Observações', cartorio:'Cartório', cartorio_obs:'Observações/documentos'
    };

    function getValues(name) {
      const fields = [...document.querySelectorAll(`[name="${name}"]`)];
      if (!fields.length) return '';
      const type = fields[0].type;
      if (type === 'radio') return (fields.find(f => f.checked) || {value:''}).value;
      if (type === 'checkbox') return fields.filter(f => f.checked).map(f => f.value).join(', ');
      return fields[0].value.trim();
    }

    function formatDate(value) {
      if (!value || !value.includes('-')) return value;
      const [y,m,d] = value.split('-');
      return `${d}/${m}/${y}`;
    }

    function safe(text) {
      return String(text || '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    }

    function gerarRelatorio() {
      let html = `<div class="report-page"><div class="report-logo">M❤️R</div><h2 class="report-title">Relatório de decisões do casamento</h2>`;
      sections.forEach(([title, names]) => {
        html += `<div class="report-section"><h3>${title}</h3>`;
        let hasAny = false;
        names.forEach(name => {
          let value = getValues(name);
          if (name.includes('data')) value = formatDate(value);
          if (value) {
            hasAny = true;
            html += `<p><strong>${labels[name]}:</strong> ${safe(value).replace(/\n/g, '<br>')}</p>`;
          }
        });
        if (!hasAny) html += `<p class="empty">Ainda não definido.</p>`;
        html += `</div>`;
      });
      html += `<div class="report-section"><p><strong>Gerado em:</strong> ${new Date().toLocaleString('pt-BR')}</p></div></div>`;
      document.getElementById('report').innerHTML = html;
      document.getElementById('report').style.display = 'block';
    }

    function gerarPDF() {
      gerarRelatorio();
      setTimeout(() => window.print(), 250);
    }
  </script>
</body>
</html>
